CONFIG_PACKAGE_mosquitto-ssl=y
CONFIG_PACKAGE_mosquitto-client-ssl=y
CONFIG_PACKAGE_luci-app-clouddrive2=y
CONFIG_PACKAGE_clouddrive2=y
